{
  "name": "fromagerie-app-backend",
  "version": "1.0.0",
  "description": "Backend Node.js/Express - gestion des commandes fromagerie",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed": "knex seed:run",
    "import:referentiel": "node src/import/import-referentiel.js",
    "import:ref-produits": "node src/import/import-ref-produits.js",
    "gmail:setup": "node src/gmail/auth.js --setup",
    "gmail:deplacer": "node src/gmail/deplacer-vers-inbox.js",
    "creer-utilisateur": "node src/auth/creer-utilisateur.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fromagerie-app": "file:..",
    "googleapis": "^140.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mysql2": "^3.10.0",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
